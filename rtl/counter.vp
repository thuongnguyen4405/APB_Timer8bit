// Reconstructed reference implementation, NOT recovered original RTL.
module counter (
    input  logic       pclk,
    input  logic       presetn,
    input  logic       enable,
    input  logic       direction_down,
    input  logic       load,
    input  logic [7:0] load_data,
    output logic [7:0] count
);
    always_ff @(posedge pclk or negedge presetn) begin
        if (!presetn)
            count <= 8'h00;
        else if (load)
            count <= load_data;
        else if (enable) begin
            if (direction_down)
                count <= count - 8'd1;
            else
                count <= count + 8'd1;
        end
    end
endmodule
