// Reconstructed reference implementation, NOT recovered original RTL.
module register (
    input  logic       pclk,
    input  logic       presetn,
    input  logic       write_en,
    input  logic [1:0] addr,
    input  logic [7:0] wdata,
    output logic [7:0] ccr,
    output logic [7:0] cdr
);
    always_ff @(posedge pclk or negedge presetn) begin
        if (!presetn) begin
            ccr <= 8'h00;
            cdr <= 8'h00;
        end else if (write_en) begin
            case (addr)
                2'b00: ccr <= wdata;
                2'b01: cdr <= wdata;
                default: ;
            endcase
        end
    end
endmodule
